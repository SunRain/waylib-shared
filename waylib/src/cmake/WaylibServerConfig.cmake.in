@PACKAGE_INIT@

set(WaylibSharedServer_VERSION "@WAYLIB_VERSION@")
set_and_check(WaylibShared_QML_IMPORT_DIR "@WAYLIB_PACKAGE_QMLDIR@")
set_and_check(WaylibShared_LIBDIR "@WAYLIB_PACKAGE_LIBDIR@")
set_and_check(WaylibShared_PKGCONFIG_DIR "@WAYLIB_PACKAGE_PKGCONFIGDIR@")
set_and_check(WaylibShared_WLROOTS_PROTOCOLS_DIR "@WAYLIB_PACKAGE_PROTOCOLSDIR@")

include(CMakeFindDependencyMacro)
# Waylib 使用 Qt Private；开发包与 runtime 只承诺相同 Qt 构建版本。
find_dependency(Qt6 @Qt6_VERSION@ EXACT COMPONENTS Core Gui Quick QmlIntegration)

# The exported WaylibShared::waylib-wlroots target links pkg-config imported
# targets; make sure they exist for downstream consumers.
find_package(PkgConfig REQUIRED)
pkg_check_modules(WAYLAND_SERVER REQUIRED IMPORTED_TARGET wayland-server>=1.26.0)
pkg_check_modules(LIBDRM REQUIRED IMPORTED_TARGET libdrm>=2.4.134)
pkg_check_modules(XKBCOMMON REQUIRED IMPORTED_TARGET xkbcommon)
pkg_check_modules(PIXMAN REQUIRED IMPORTED_TARGET pixman-1>=0.46.4)
pkg_check_modules(XCB REQUIRED IMPORTED_TARGET xcb)

include("${CMAKE_CURRENT_LIST_DIR}/WaylibSharedServerTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/WaylibProtocolHelpers.cmake")

# WaylibServer's public headers include <wlr_all.h>, so consumers must be
# able to resolve the exported wlroots target (and its installed wlr/
# include dir, carried on the target's INTERFACE_INCLUDE_DIRECTORIES). Fail
# loudly here instead of letting downstream link errors surface later.
if(NOT TARGET WaylibShared::waylib-wlroots)
    message(FATAL_ERROR
        "WaylibShared requires its matching WaylibShared::waylib-wlroots target. "
        "Reinstall the complete development package and runtime; no system-library fallback is used.")
endif()

check_required_components(WaylibSharedServer)
